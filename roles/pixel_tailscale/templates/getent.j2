#!/system/bin/sh
# Minimal getent implementation for Android user/group lookups by Tailscale SSH
db="$1"
key="${2:-}"
case "$db" in
  passwd)
    if [ -n "$key" ]; then
      grep -E "^($key:|[^:]*:[^:]*:$key:)" /etc/passwd 2>/dev/null
    else
      cat /etc/passwd 2>/dev/null
    fi
    ;;
  group)
    if [ -n "$key" ]; then
      grep -E "^($key:|[^:]*:[^:]*:$key:)" /etc/group 2>/dev/null
    else
      cat /etc/group 2>/dev/null
    fi
    ;;
  *)
    exit 2
    ;;
esac
