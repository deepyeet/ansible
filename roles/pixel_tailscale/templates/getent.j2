#!/system/bin/sh
# Minimal getent implementation for Android user/group lookups by Tailscale SSH
db="$1"
key="${2:-}"
case "$db" in
  passwd)
    if [ -f /etc/passwd ]; then
      if [ -n "$key" ]; then
        grep -E "^($key:|[^:]*:[^:]*:$key:)" /etc/passwd 2>/dev/null
      else
        cat /etc/passwd 2>/dev/null
      fi
    elif [ "$key" = "root" ] || [ "$key" = "0" ] || [ -z "$key" ]; then
      echo "root:x:0:0:root:/data/ssh/root:/system/bin/sh"
    fi
    ;;
  group)
    if [ -f /etc/group ]; then
      if [ -n "$key" ]; then
        grep -E "^($key:|[^:]*:[^:]*:$key:)" /etc/group 2>/dev/null
      else
        cat /etc/group 2>/dev/null
      fi
    elif [ "$key" = "root" ] || [ "$key" = "0" ] || [ -z "$key" ]; then
      echo "root:x:0:"
    fi
    ;;
  *)
    exit 2
    ;;
esac
