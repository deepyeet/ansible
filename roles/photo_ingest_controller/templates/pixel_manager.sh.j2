#!/bin/bash

# --- SINGLETON LOCK ---
LOCKFILE="{{ photo_ingest.state_dir }}/pixel_manager.lock"
exec 200>"$LOCKFILE"
flock -n 200 || { echo "Script is already running. Aborting."; exit 1; }

# --- CONFIGURATION ---
BASE_DIR="{{ photo_ingest.base_dir }}"
PIXEL_IP="{{ photo_ingest_endpoint.address }}"
# B31 file channel: this key is pinned on the phone to an rsync daemon
# confined to the managed tree (no shell). All file ops ride it.
# B31 part 3: the old root SSH key is gone entirely -- the manager has
# no exec channel to the phone. The triggers that used it (promote,
# free-up) are on-device cron jobs now; the manager only watches
# their status files (below).
FILE_KEY="{{ photo_ingest.file_key_path }}"
FILE_RSH="ssh -p {{ photo_ingest_endpoint.ssh_port }} -i $FILE_KEY"
CANARY_FETCH="{{ photo_ingest.state_dir }}/.canary_fetch"
EMPTY_SRC="{{ photo_ingest.state_dir }}/.empty_src"
PROM_FETCH="{{ photo_ingest.state_dir }}/.promote_status_fetch"
PROMOTER_MAX_AGE=720
FREEUP_FETCH="{{ photo_ingest.state_dir }}/.freeup_status_fetch"
FREEUP_MAX_AGE=1800
HC_URL="{{ photo_ingest_healthcheck_url }}"

# Pixel Paths
PIXEL_ROOT="{{ photo_ingest_endpoint.root }}"
PIXEL_INCOMING="$PIXEL_ROOT/incoming"
PIXEL_STAGING="$PIXEL_ROOT/.staging"
CANARY_FILE="$PIXEL_ROOT/.mount_check"

# Local State Folders
DIR_INBOX="$BASE_DIR/0_Inbox"
DIR_QUEUE="$BASE_DIR/1_Queue"
DIR_UPLOADING="$BASE_DIR/2_Uploading"
DIR_DONE="$BASE_DIR/3_Done"
TEMP_LIST="{{ photo_ingest.state_dir }}/pixel_incoming_state.txt"

mkdir -p "$DIR_INBOX" "$DIR_QUEUE" "$DIR_UPLOADING" "$DIR_DONE"
curl -fsS -m 10 --retry 3 "$HC_URL/start" > /dev/null

function handle_exit {
    if [ $? -ne 0 ]; then
        curl -fsS -m 10 --retry 5 "$HC_URL/fail"
    fi
}

trap handle_exit EXIT

# --- SAFETY CHECK 1: PRE-FLIGHT CANARY ---
# B31: canary existence is proven by fetching it over the file channel.
if ! rsync --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.mount_check" "$CANARY_FETCH" > /dev/null 2>&1; then
    echo "[CRITICAL] Mount Canary missing! Drive is NOT mounted."
    curl -fsS -m 10 --retry 3 "$HC_URL/fail" > /dev/null
    exit 1
fi

# --- CLEANUP ARTIFACTS ---
echo "Cleaning up metadata and thumbnail artifacts..."
for TARGET_DIR in "$DIR_INBOX" "$DIR_UPLOADING"; do
    if [ -d "$TARGET_DIR" ]; then
        # Delete @eaDir directories and their contents
        find "$TARGET_DIR" -depth -name "@eaDir" -type d -exec rm -rf {} +

        # Delete Windows/Synology thumbnail databases
        find "$TARGET_DIR" -type f \( -name "Thumbs.db" -o -name "Thumbs_*.db" \) -delete
    fi
done

# --- SAFETY CHECK 2: INGEST & DEDUPE ---
if [ "$(ls -A "$DIR_INBOX")" ]; then
    echo "Processing Inbox..."
    # Vacuum all subfolders, flatten, hash, and move
    # Exclude: @Syno folders, Hidden files (.*), and SYNOFILE_THUMB files
    find "$DIR_INBOX" -type f \
      ! -name "*@Syno*" \
      ! -name ".*" \
      ! -name "SYNOFILE_THUMB*" \
      ! -name "Thumbs*.db" \
      -mmin +{{ photo_ingest.ingest_age }} \
      -newermt "{{ photo_ingest.ingest_min_date }}" \
    | while read -r FILE_PATH; do
        FILENAME=$(basename "$FILE_PATH")
        EXTENSION="${FILENAME##*.}"
        NAME_ONLY="${FILENAME%.*}"
        
        FILE_HASH=$(md5sum "$FILE_PATH" | awk '{print $1}')
        SHORT_HASH=${FILE_HASH:0:8}
        NEW_NAME="${NAME_ONLY}_${SHORT_HASH}.${EXTENSION}"
        
        if [ -f "$DIR_QUEUE/$NEW_NAME" ] || \
           [ -f "$DIR_UPLOADING/$NEW_NAME" ] || \
           [ -f "$DIR_DONE/$NEW_NAME" ]; then
            echo "Duplicate Detected (Discarding): $FILENAME"
            rm "$FILE_PATH"
        else
            mv "$FILE_PATH" "$DIR_QUEUE/$NEW_NAME"
            echo "Ingested: $FILENAME -> $NEW_NAME"
        fi
    done
    find "$DIR_INBOX" -mindepth 2 -type d -empty -delete
fi

# --- ON-DEVICE JOB LIVENESS (B31 parts 2+3) ---
# The on-phone promoter (busybox crond) rewrites .promote_status in the
# tree root on every tick (2 min). Fetch it now: if it is missing or
# older than PROMOTER_MAX_AGE, the cycle still does its work, but every
# success ping below is replaced by a fail ping, so a dead promoter is
# not silent. The phone being down is already caught by the canary.
PROMOTER_STALE=0
if rsync --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.promote_status" "$PROM_FETCH" > /dev/null 2>&1; then
    PROM_EPOCH=$(awk 'NR==1 {print $1}' "$PROM_FETCH")
    case "$PROM_EPOCH" in
        ''|*[!0-9]*) PROMOTER_STALE=1 ;;
        *) [ $(( $(date +%s) - PROM_EPOCH )) -gt $PROMOTER_MAX_AGE ] && PROMOTER_STALE=1 ;;
    esac
else
    PROMOTER_STALE=1
fi
[ "$PROMOTER_STALE" -eq 1 ] && echo "[WARN] Promoter status missing or stale - healthcheck will report failure."

# Same watchdog for the free-up job (B31 part 3): its wrapper
# rewrites .freeup_status on every tick (10 min). Crond death is
# already caught by the promoter check; this one catches the
# free-up job itself wedging or being removed.
FREEUP_STALE=0
if rsync --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.freeup_status" "$FREEUP_FETCH" > /dev/null 2>&1; then
    FREEUP_EPOCH=$(awk 'NR==1 {print $1}' "$FREEUP_FETCH")
    case "$FREEUP_EPOCH" in
        ''|*[!0-9]*) FREEUP_STALE=1 ;;
        *) [ $(( $(date +%s) - FREEUP_EPOCH )) -gt $FREEUP_MAX_AGE ] && FREEUP_STALE=1 ;;
    esac
else
    FREEUP_STALE=1
fi
[ "$FREEUP_STALE" -eq 1 ] && echo "[WARN] Free-up status missing or stale - healthcheck will report failure."

function final_ping {
    if [ "$PROMOTER_STALE" -eq 1 ] || [ "$FREEUP_STALE" -eq 1 ]; then
        curl -fsS -m 10 --retry 3 "$HC_URL/fail" > /dev/null
    else
        curl -fsS -m 10 --retry 3 "$HC_URL" > /dev/null
    fi
}

# --- STEP 2: PUSH (Queue -> Pixel Staging) ---
if [ -z "$(ls -A "$DIR_QUEUE")" ] && [ -z "$(ls -A "$DIR_UPLOADING")" ]; then
    echo "Queue and Uploading empty. Sync complete."
    final_ping
    exit 0
fi

if [ "$(ls -A "$DIR_QUEUE")" ]; then
    echo "Rsyncing to Staging..."
    # --omit-dir-times: the daemon (uid 2000) cannot set times on the
    # root-owned .staging dir; without it rsync exits 23 and the cycle
    # aborts before the state fetch (latent part-1 bug, found by the
    # part-2 end-to-end probe, 2026-10-19).
    rsync -av --progress --partial-dir=.rsync-partial --omit-dir-times --timeout={{ photo_ingest.rsync_timeout }} \
        --rsh="$FILE_RSH" \
        --delete-after \
        "$DIR_QUEUE"/ \
        "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.staging/"

    if [ $? -ne 0 ]; then
        echo "[ERROR] Rsync failed. Aborting."
        curl -fsS -m 10 --retry 3 "$HC_URL/fail" > /dev/null
        exit 1
    fi

    # --- STEP 3: PROMOTE (Staging -> Incoming) ---
    # B31 part 2: promotion is owned by the on-phone promoter
    # (promote.sh under busybox crond, every 2 min). The manager only
    # pushes; the state fetch in the NEXT cycle confirms receipt.
fi

# --- STEP 4 & 5: BATCH VERIFICATION ---
echo "Fetching Pixel State..."

# 1. Verify Canary (Start)
# 2. List Files
# 3. Verify Canary (End)
# If the drive drops at any point, the chain fails (Exit != 0), and we assume invalid state.
# B31: the canary/listing/canary triple check, as three file-channel round
# trips. Any failure breaks the chain and aborts below, as before.
mkdir -p "$EMPTY_SRC"
rsync --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.mount_check" "$CANARY_FETCH" > /dev/null 2>&1 && \
rsync -rn --out-format='%n' --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/incoming/" "$EMPTY_SRC/" > "$TEMP_LIST" && \
rsync --timeout=30 --rsh="$FILE_RSH" "{{ photo_ingest_endpoint.ssh_user }}@$PIXEL_IP::pixel/.mount_check" "$CANARY_FETCH" > /dev/null 2>&1

if [ $? -ne 0 ]; then
    echo "[CRITICAL] State verification failed (Drive unstable or disconnected). Aborting."
    rm -f "$TEMP_LIST"
    curl -fsS -m 10 --retry 3 "$HC_URL/fail" > /dev/null
    exit 1
fi

echo "State fetched. Processing lists..."

# 4. Verify Receipt (Queue -> Uploading)
cd "$DIR_QUEUE" || exit
find . -maxdepth 1 -type f | while read -r FILE; do
    CLEAN_FILE="${FILE#./}"
    # Grep the local text file (Instant)
    if grep -Fqx "$CLEAN_FILE" "$TEMP_LIST"; then
        echo "Confirmed on Pixel: $CLEAN_FILE"
        mv "$CLEAN_FILE" "$DIR_UPLOADING/"
    fi
done

# 5. Check Completion (Uploading -> Done)
cd "$DIR_UPLOADING" || exit
find . -maxdepth 1 -type f | while read -r FILE; do
    CLEAN_FILE="${FILE#./}"
    # If file is NOT in the list, it has been uploaded/deleted by Google Photos
    if ! grep -Fqx "$CLEAN_FILE" "$TEMP_LIST"; then
        echo "Upload Complete: $CLEAN_FILE"
        mv "$CLEAN_FILE" "$DIR_DONE/"
    fi
done

# Cleanup
rm -f "$TEMP_LIST"

# --- FREE-UP ---
# B31 part 3: free-up is an on-device cron job now (free_up.sh owns
# the 8h stamp and the gates). The manager no longer triggers it;
# it only watches .freeup_status (see the liveness block above).

# --- MONITORING ---
echo "Sync Cycle Complete."
final_ping
